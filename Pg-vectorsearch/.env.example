# Copy this file to .env and replace the placeholders with your Tiger Cloud
# service connection string and OpenAI API key. After creating a service with
# Tiger CLI, run `tiger db uri --with-password` to get DATABASE_URL.
DATABASE_URL=postgresql://tsdbadmin:your-password@your-host:5432/tsdb?sslmode=require
OPENAI_API_KEY=your-key-here

# Use a text-embedding-3 model. The scripts request 1,536 output dimensions to
# match setup.sql even when a larger compatible model is selected.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
