POSTGRES_PASSWORD=state-of-search-demo
DATABASE_URL=postgresql://postgres:state-of-search-demo@db:5432/state_of_search

# Required for semantic search and the embedding preparation step.
OPENAI_API_KEY=your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# sample: 5,000 events; demo: 50,000; benchmark: 250,000.
DATASET_PROFILE=sample
EMBED_BATCH_SIZE=100

ELASTIC_URL=http://elasticsearch:9200
ELASTIC_VERSION=9.5.4
